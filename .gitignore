.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example
*.pem
*.key
*.cert
*.crt

# --- Databases & Local Storage ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
healthcare_ai.db
data/*.db

# --- Python & Backend Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/__pycache__/
backend/app/**/__pycache__/

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
backend/venv/
backend/.venv/

